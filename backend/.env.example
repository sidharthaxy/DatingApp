# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
# "development" forces the Firebase Auth EMULATOR. Use "production" with real Firebase.
NODE_ENV="development"

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/datingapp"

# ─── Redis (token blacklist, discovery cache, online presence) ───────────────
REDIS_URL="redis://127.0.0.1:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"
REFRESH_JWT_SECRET="change-me-too"

# ─── Firebase Admin ──────────────────────────────────────────────────────────
# [DEPLOYMENT] Remove FIREBASE_AUTH_EMULATOR_HOST in production to use real Firebase Auth
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─── Object storage (MinIO locally, S3 / Cloudflare R2 in production) ────────
# How THIS server reaches storage
STORAGE_ENDPOINT="http://127.0.0.1:9000"
# How browsers / phones reach the same S3 API. Defaults to STORAGE_ENDPOINT.
# Laptop browser only: leave unset. Phone on Wi-Fi: http://<your-LAN-IP>:9000.
# STORAGE_PUBLIC_URL="http://192.168.0.10:9000"
# Optional CDN / public bucket base for photo + chat media links: <MEDIA_BASE_URL>/<key>
# MEDIA_BASE_URL="https://media.example.com"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET_NAME="minglex-media"
STORAGE_REGION="us-east-1"

# ─── Razorpay (test mode keys are fine locally) ──────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Rate limits (optional overrides; requests per window) ───────────────────
# RATE_LIMIT_GLOBAL=1500   # per 15 min, per IP
# RATE_LIMIT_AUTH=30       # per 15 min, per IP (token refresh is exempt)
# RATE_LIMIT_SWIPE=50      # per minute, per IP
