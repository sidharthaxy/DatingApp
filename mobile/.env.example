# ─── Firebase web config (Firebase Console → Project settings → Your apps) ───
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ─── Backend ─────────────────────────────────────────────────────────────────
# Keep "localhost" for local development: it is correct in the laptop browser, and on a
# phone the app automatically swaps it for your computer's LAN address (src/lib/config.ts).
# [DEPLOYMENT] Set to your production API, e.g. https://api.minglex.com
EXPO_PUBLIC_API_URL="http://localhost:8000"

# ─── Firebase Auth emulator (local sign-in without real Google accounts) ─────
# [DEPLOYMENT] Set EXPO_PUBLIC_USE_EMULATOR to "false"
EXPO_PUBLIC_USE_EMULATOR="true"
EXPO_PUBLIC_EMULATOR_URL="http://localhost:9099"

# ─── Google Sign-In OAuth client IDs (production native sign-in) ─────────────
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
